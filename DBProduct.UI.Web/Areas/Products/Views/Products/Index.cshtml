@model List<DBProduct.UI.ViewModel.Product.ProductViewModel>

@{
    ViewBag.Title = "Product Management";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Product Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f9;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .header h1 {
            margin: 0;
            color: #222;
        }

        .header p {
            margin-top: 6px;
            color: #666;
        }

        .add-button {
            background-color: #2563eb;
            color: white;
            padding: 12px 18px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .add-button:hover {
            background-color: #1d4ed8;
        }

        .summary-container {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }

        .summary-card {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            flex: 1;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .summary-card h3 {
            margin: 0 0 10px 0;
            color: #666;
            font-size: 15px;
        }

        .summary-card .number {
            font-size: 28px;
            font-weight: bold;
            color: #222;
        }

        .toolbar {
            background-color: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            display: flex;
            gap: 15px;
        }

        .search-box {
            flex: 1;
        }

        .search-box input,
        .filter-box select {
            width: 100%;
            padding: 11px;
            border: 1px solid #ccc;
            border-radius: 5px;
            box-sizing: border-box;
        }

        .filter-box {
            width: 180px;
        }

        .table-container {
            background-color: white;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            background-color: #f1f5f9;
            text-align: left;
            padding: 14px;
            color: #444;
        }

        td {
            padding: 14px;
            border-bottom: 1px solid #eee;
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .available {
            color: #15803d;
            font-weight: bold;
        }

        .unavailable {
            color: #dc2626;
            font-weight: bold;
        }

        .edit-button {
            color: #2563eb;
            text-decoration: none;
            font-weight: bold;
            margin-right: 10px;
        }

        .edit-button:hover {
            text-decoration: underline;
        }

        .delete-button {
            background-color: #dc2626;
            color: white;
            border: none;
            padding: 7px 12px;
            border-radius: 5px;
            cursor: pointer;
        }

        .delete-button:hover {
            background-color: #b91c1c;
        }

        .no-results {
            text-align: center;
            padding: 30px;
            color: #777;
            display: none;
        }

        @@media (max-width: 768px) {

            .header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            .summary-container {
                flex-direction: column;
            }

            .toolbar {
                flex-direction: column;
            }

            .filter-box {
                width: 100%;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- HEADER -->
        <div class="header">

            <div>
                <h1>Product Management</h1>

                <p>
                    Manage products in the DBProduct catalogue
                </p>
            </div>

            <a href="/Products/Products/Create"
               class="add-button">
                + Add Product
            </a>

        </div>


        <!-- SUMMARY CARDS -->

        <div class="summary-container">

            <div class="summary-card">

                <h3>Total Products</h3>

                <div class="number" id="totalProducts">
                    @Model.Count
                </div>

            </div>


            <div class="summary-card">

                <h3>Available Products</h3>

                <div class="number" id="availableProducts">
                    @Model.Count(x => x.IsAvailable)
                </div>

            </div>


            <div class="summary-card">

                <h3>Unavailable Products</h3>

                <div class="number" id="unavailableProducts">
                    @Model.Count(x => !x.IsAvailable)
                </div>

            </div>

        </div>


        <!-- SEARCH + FILTER -->

        <div class="toolbar">

            <div class="search-box">

                <input type="text"
                       id="searchInput"
                       placeholder="Search by product name or manufacturer..." />

            </div>


            <div class="filter-box">

                <select id="availabilityFilter">

                    <option value="all">
                        All Products
                    </option>

                    <option value="available">
                        Available
                    </option>

                    <option value="unavailable">
                        Unavailable
                    </option>

                </select>

            </div>

        </div>


        <!-- PRODUCT TABLE -->

        <div class="table-container">

            <table id="productTable">

                <thead>

                    <tr>

                        <th>Product ID</th>

                        <th>Product Name</th>

                        <th>Description</th>

                        <th>Amount</th>

                        <th>Manufacturer</th>

                        <th>Available</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var product in Model)
                    {
                        <tr class="product-row"
                            data-name="@product.ProductName.ToLower()"
                            data-manufacturer="@product.Manufacturer.ToLower()"
                            data-available="@product.IsAvailable.ToString().ToLower()">

                            <td>
                                @product.ProductID
                            </td>

                            <td>
                                <strong>
                                    @product.ProductName
                                </strong>
                            </td>

                            <td>
                                @product.Description
                            </td>

                            <td>
                                ₹ @product.Amount
                            </td>

                            <td>
                                @product.Manufacturer
                            </td>

                            <td>

                                @if (product.IsAvailable)
                                {
                                    <span class="available">
                                        ● Available
                                    </span>
                                }
                                else
                                {
                                    <span class="unavailable">
                                        ● Unavailable
                                    </span>
                                }

                            </td>

                            <td>

                                <a href="/Products/Products/Edit/@product.ProductID"
                                   class="edit-button">
                                    Edit
                                </a>


                                <form action="/Products/Products/Delete/@product.ProductID"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirmDelete('@product.ProductName');">

                                    <button type="submit"
                                            class="delete-button">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>


            <div id="noResults"
                 class="no-results">

                No products found.

            </div>

        </div>

    </div>


    <script>

        /*
         * SEARCH FUNCTION
         */

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                filterProducts();

            });


        /*
         * AVAILABILITY FILTER
         */

        document.getElementById("availabilityFilter")
            .addEventListener("change", function () {

                filterProducts();

            });


        /*
         * COMMON FILTER FUNCTION
         */

        function filterProducts() {

            var searchValue =
                document.getElementById("searchInput")
                    .value
                    .toLowerCase();

            var filterValue =
                document.getElementById("availabilityFilter")
                    .value;

            var rows =
                document.querySelectorAll(".product-row");

            var visibleCount = 0;


            rows.forEach(function (row) {

                var productName =
                    row.getAttribute("data-name");

                var manufacturer =
                    row.getAttribute("data-manufacturer");

                var available =
                    row.getAttribute("data-available");


                /*
                 * Search condition
                 */

                var matchesSearch =
                    productName.includes(searchValue) ||
                    manufacturer.includes(searchValue);


                /*
                 * Availability condition
                 */

                var matchesFilter =
                    filterValue === "all" ||
                    (filterValue === "available" &&
                     available === "true") ||
                    (filterValue === "unavailable" &&
                     available === "false");


                /*
                 * Show / hide row
                 */

                if (matchesSearch && matchesFilter) {

                    row.style.display = "";

                    visibleCount++;

                }
                else {

                    row.style.display = "none";

                }

            });


            /*
             * Show "No products found"
             */

            var noResults =
                document.getElementById("noResults");


            if (visibleCount === 0) {

                noResults.style.display = "block";

            }
            else {

                noResults.style.display = "none";

            }

        }


        /*
         * DELETE CONFIRMATION
         */

        function confirmDelete(productName) {

            return confirm(
                "Are you sure you want to delete '" +
                productName +
                "'?"
            );

        }

    </script>

</body>
</html>